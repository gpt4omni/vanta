#!/usr/bin/env bash
# The AppImage's entry point. appimagetool runs this in place of the
# executable named in the desktop file, with the mounted (or extracted)
# AppDir as the working directory.
#
# Everything here exists to answer one question: once vanta-shell is moved
# off the machine it was built on, how does it find the things it needs that
# are not DT_NEEDED entries and so were not swept up by linuxdeploy's
# dependency walk in build-appimage.sh? Each export below is one such thing.
set -euo pipefail

APPDIR="${APPDIR:-$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"

# Bundled libraries ahead of the host's own. The whole reason this AppImage
# exists rather than a bare tarball of the two binaries is that the host's
# gtk4/libadwaita can be older than what this workspace builds against, and
# the failure mode for an ordinary build against an old system library is
# three *-sys build scripts refusing to configure. The margin is wider than
# it was -- ADR-032 brought the floor down to gtk4 4.12 and libadwaita 1.5,
# so far fewer hosts are below it than when this said 4.22/1.9 -- but a
# bundled copy is what makes the margin irrelevant rather than merely large.
# An AppImage sidesteps that only if it actually carries its own copies
# rather than linking the host's, which is what this line is for.
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${LD_LIBRARY_PATH:-}"

# Ubuntu 24.04's bundled GTK 4.14.5 defaults to GskNglRenderer, which suffers
# from blank-window failures on Wayland with NVIDIA/Mesa/wlroots compositors.
# The host GTK window only draws the headerbar, launcher, and dialogs -- the
# engine's Vulkan game subsurface renders independently -- so cairo has zero
# game performance cost and works universally. Users can override GSK_RENDERER.
export GSK_RENDERER="${GSK_RENDERER:-cairo}"

# GSettings schemas are found by path lookup through GIO, not through a
# symbol linuxdeploy's ELF dependency walk can see -- nothing in
# vanta-shell references the schema directory by name, so nothing about it
# survives an ordinary --executable bundling pass. build-appimage.sh compiles
# a copy into usr/share/glib-2.0/schemas for exactly this reason.
export GSETTINGS_SCHEMA_DIR="${APPDIR}/usr/share/glib-2.0/schemas"

export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Bundled libgdk_pixbuf-2.0.so.0 hardcodes Ubuntu's multiarch loaders path,
# which does not exist on Arch, Fedora, openSUSE, or NixOS. Materialize a
# per-user loaders.cache pointing into the current AppImage mount so SVG icons
# and bundled artwork load on every distribution.
pixbuf_cache_in="${APPDIR}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache.in"
if [ -f "$pixbuf_cache_in" ]; then
    pixbuf_cache="${XDG_RUNTIME_DIR:-/tmp}/vanta-appimage-loaders-${UID}.cache"
    if [ -z "${VANTA_APPIMAGE_WRAPPED:-}" ] || [ ! -f "$pixbuf_cache" ]; then
        appdir_escaped=${APPDIR//\\/\\\\}
        appdir_escaped=${appdir_escaped//&/\\&}
        appdir_escaped=${appdir_escaped//|/\\|}
        if sed "s|@APPDIR@|${appdir_escaped}|g" "$pixbuf_cache_in" > "${pixbuf_cache}.tmp.$$" 2>/dev/null; then
            mv -f "${pixbuf_cache}.tmp.$$" "$pixbuf_cache" 2>/dev/null || rm -f "${pixbuf_cache}.tmp.$$"
        else
            rm -f "${pixbuf_cache}.tmp.$$"
        fi
    fi
    if [ -f "$pixbuf_cache" ]; then
        export GDK_PIXBUF_MODULE_FILE="$pixbuf_cache"
    fi
fi

# Bundled libgio-2.0.so.0 likewise hardcodes Ubuntu's multiarch GIO modules
# directory; point it at the bundled modules (e.g. libgiognutls.so for TLS).
if [ -d "${APPDIR}/usr/lib/gio/modules" ]; then
    export GIO_MODULE_DIR="${APPDIR}/usr/lib/gio/modules"
fi

# ---------------------------------------------------------------------------
# WebKitGTK's baked-in absolute paths
#
# WebKitGTK spawns WebKitWebProcess, WebKitNetworkProcess, and WebKitGPUProcess
# as separate executables, dlopens libwebkitgtkinjectedbundle.so, and shells out
# to /usr/bin/bwrap and /usr/bin/xdg-dbus-proxy for its sandbox. Production
# builds of libwebkitgtk-6.0.so do not honor WEBKIT_EXEC_PATH, so the baked-in
# paths must exist at runtime.
#
# build-appimage.sh patches Ubuntu's multiarch strings
# (`/usr/lib/<arch>-linux-gnu/webkitgtk-6.0` and
# `/usr/lib/<arch>-linux-gnu/webkitgtk-6.0/injected-bundle/`) in-place to
# `/usr/libexec/webkitgtk-6.0` (and `/usr/libexec/webkitgtk-6.0/injected-bundle/`)
# and lays out both helpers and injected-bundle under
# `${APPDIR}/usr/libexec/webkitgtk-6.0`. Binding that single directory onto
# `/usr/libexec/webkitgtk-6.0` inside an unprivileged bwrap mount namespace
# makes WebKitGTK work identically across Arch, Fedora, Ubuntu, Debian,
# openSUSE, and NixOS.
#
# VANTA_APPIMAGE_NO_WRAP=1 skips the mount namespace; VANTA_APPIMAGE_WRAPPED is
# the internal recursion guard set across the re-exec.
export WEBKIT_EXEC_PATH="${APPDIR}/usr/libexec/webkitgtk-6.0"
if [ -d "${APPDIR}/usr/libexec/webkitgtk-6.0/injected-bundle" ]; then
    export WEBKIT_INJECTED_BUNDLE_PATH="${APPDIR}/usr/libexec/webkitgtk-6.0/injected-bundle"
elif [ -d "${APPDIR}/usr/lib/webkitgtk-6.0/injected-bundle" ]; then
    export WEBKIT_INJECTED_BUNDLE_PATH="${APPDIR}/usr/lib/webkitgtk-6.0/injected-bundle"
fi

if [ -z "${VANTA_APPIMAGE_WRAPPED:-}" ] \
   && [ -z "${VANTA_APPIMAGE_NO_WRAP:-}" ] \
   && [ -d "${APPDIR}/usr/libexec/webkitgtk-6.0" ]; then
    # Prefer the host's /usr/bin/bwrap when present (e.g. on Ubuntu 24.04 where
    # AppArmor grants unprivileged userns specifically to /usr/bin/bwrap), and
    # fall back to the bundled copy on hosts without bwrap (or with an older
    # bwrap that lacks --overlay-src).
    for bwrap in /usr/bin/bwrap "${APPDIR}/usr/bin/bwrap"; do
        [ -x "$bwrap" ] || continue

        overlaid_usr=0
        if [ -d /usr/libexec ]; then
            args=(--dev-bind / / --die-with-parent
                  --overlay-src /usr/libexec --tmp-overlay /usr/libexec
                  --bind "${APPDIR}/usr/libexec/webkitgtk-6.0" /usr/libexec/webkitgtk-6.0)
        else
            # Minimal hosts without /usr/libexec: overlay /usr so the bind
            # mountpoint can be created inside the private namespace.
            overlaid_usr=1
            args=(--dev-bind / / --die-with-parent
                  --overlay-src /usr --tmp-overlay /usr
                  --bind "${APPDIR}/usr/libexec/webkitgtk-6.0" /usr/libexec/webkitgtk-6.0)
        fi

        # Compatibility for Fedora-built libwebkitgtk-6.0.so if ever used
        # directly without multiarch patching.
        if [ -d /usr/lib64/webkitgtk-6.0 ] \
           && [ -d "${APPDIR}/usr/libexec/webkitgtk-6.0/injected-bundle" ]; then
            args+=(--ro-bind "${APPDIR}/usr/libexec/webkitgtk-6.0/injected-bundle" /usr/lib64/webkitgtk-6.0/injected-bundle)
        fi

        # WebKitGTK's sandbox execs /usr/bin/bwrap and /usr/bin/xdg-dbus-proxy
        # by absolute path. Plant bundled copies only when the host lacks them.
        plant=()
        for tool in bwrap xdg-dbus-proxy; do
            if [ ! -x "/usr/bin/$tool" ] && [ -x "${APPDIR}/usr/bin/$tool" ]; then
                plant+=("$tool")
            fi
        done
        if [ ${#plant[@]} -gt 0 ] && [ -d /usr/bin ]; then
            if [ "$overlaid_usr" -eq 0 ]; then
                args+=(--overlay-src /usr/bin --tmp-overlay /usr/bin)
            fi
            for tool in "${plant[@]}"; do
                args+=(--ro-bind "${APPDIR}/usr/bin/$tool" "/usr/bin/$tool")
            done
        fi

        # Probe with the real argument list so a kernel or policy that refuses
        # unprivileged userns/overlayfs falls through cleanly to the next
        # candidate or the warning below instead of aborting launch.
        "$bwrap" "${args[@]}" -- /bin/true >/dev/null 2>&1 || continue

        export VANTA_APPIMAGE_WRAPPED=1
        exec "$bwrap" "${args[@]}" -- "${APPDIR}/AppRun" "$@"
    done

    if [ ! -x /usr/libexec/webkitgtk-6.0/WebKitNetworkProcess ]; then
        echo "vanta: could not set up a mount namespace (no usable bwrap, or" >&2
        echo "  unprivileged overlayfs refused), and /usr/libexec/webkitgtk-6.0" >&2
        echo "  is absent on this host. Sign-in / web views may open blank." >&2
        echo "  Install a native distribution package of Vanta, or enable" >&2
        echo "  unprivileged user namespaces / bubblewrap." >&2
    fi
fi

exec "${APPDIR}/usr/bin/vanta-shell" "$@"
