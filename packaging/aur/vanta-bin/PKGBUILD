# Maintainer: gpt4omni <gpt4omni@users.noreply.github.com>
#
# Prebuilt counterpart to packaging/aur/vanta/PKGBUILD. Where vanta (and
# vanta-git) build the Rust workspace with cargo, this package downloads the
# .pkg.tar.zst that CI attaches to the GitHub release -- itself the output of
# `makepkg` against packaging/aur/vanta/PKGBUILD on the same tag -- and
# repacks it untouched. No compilation, so arch lives with that artifact.
# Nothing here downloads, embeds or references any Roblox material: it is the
# same source-built package the two other PKGBUILDs produce, which Vanta's
# install note on all three already describes.
#
# Why this stays version-pinned rather than asking GitHub for "the latest
# release": the version a package reports to the AUR is the one its .SRCINFO
# declares, and helper tools (yay, paru, ...) decide whether an upgrade exists
# by comparing that pkgver with what is installed. A build that resolves the
# newest artifact at build time would have to ship a SKIP checksum (nothing is
# known about a not-yet-downloaded file), which the AUR trust model exists to
# avoid, and the declared pkgver would not be the artifact's real version, so
# upgrade tracking would silently misreport. The pinned sha256 is the trust
# anchor instead; a release bump touches pkgver, the asset URL and the checksum
# together, all three regenerated by `sha256sum` on the downloaded file.
#
# The asset name embeds the `git describe` build id (0.34.0.r0.gfe20025 in this
# case), so a release bump touches both $pkgver and the pinned URL below. The
# -x86_64 token is $CARCH for the day aarch64 artifacts exist upstream, so a
# future release slots in here without editing the arch.

pkgname=vanta-bin
pkgver=0.34.0
pkgrel=1
pkgdesc="Roblox's official Android build, run natively on Linux -- Vanta ships no Roblox code and fetches a signature-verified one (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/gpt4omni/vanta"
license=('GPL-3.0-or-later')
depends=(
  'gtk4'
  'libadwaita'
  'webkitgtk-6.0'
  'zlib'
  'glib2'
  'pango'
  'graphene'
  'libsoup3'
  'libgcc'
  'libstdc++'
  'glibc'
  'vulkan-icd-loader'
  'wayland'
  'libxkbcommon'
  'libglvnd'
  'pipewire'
  'hicolor-icon-theme'
  'deno'
)
conflicts=('vanta' 'vanta-git')
install="$pkgname.install"
# The binaries in the artifact were already stripped by CI's own makepkg;
# stripping them again fails and would not make them byte-identical.
options=('!strip' '!debug')
source_x86_64=("vanta.pkg.tar.zst::https://github.com/gpt4omni/vanta/releases/download/v$pkgver/vanta-0.34.0.r0.gfe20025-1-x86_64.pkg.tar.zst")
sha256sums_x86_64=('d1a72ea80a2ee936ae129c904b9f3274eeba1bb5f0d4c0467dc3c6e575dc8f88')
source_aarch64=("vanta.pkg.tar.zst::https://github.com/gpt4omni/vanta/releases/download/v$pkgver/vanta-0.34.0.r0.gfe20025-1-aarch64.pkg.tar.zst")
sha256sums_aarch64=('SKIP')

package() {
  bsdtar -xf "$srcdir/vanta.pkg.tar.zst" -C "$pkgdir"
  # The artifact is itself a pacman package; makepkg regenerates these as the
  # vanta-bin package's own instead of letting them leak through.
  rm -f "$pkgdir"/.BUILDINFO "$pkgdir"/.INSTALL "$pkgdir"/.MTREE "$pkgdir"/.PKGINFO
}