+#if defined(__linux__) && defined(__LP64__) && defined(MADV_HUGEPAGE)
+      // Vanta, patches/0009: keep large non-writable segments (>= 4 MiB, such as
+      // libroblox.so's ~105 MiB .text) file-backed at `prot` (r-xp / r--p) and
+      // advise MADV_HUGEPAGE on the 2 MiB-aligned interior. Eliminates the
+      // blocking pread64 copy + MADV_COLLAPSE stall on dlopen and avoids
+      // 60-102 MiB of private anonymous RSS while letting khugepaged / large
+      // folios collapse hot executable ranges into 2 MiB iTLB entries. Guarded
+      // on 4 KiB host pages and disabled when VANTA_NO_HUGEPAGE_TEXT is set.
+      if ((phdr->p_flags & PF_W) == 0 && file_length >= (4ULL << 20) &&
+          sysconf(_SC_PAGESIZE) == 4096 &&
+          getenv("VANTA_NO_HUGEPAGE_TEXT") == nullptr) {
+        constexpr uintptr_t kHuge = 2ULL << 20;
+        uintptr_t h_start = (static_cast<uintptr_t>(seg_page_start) + kHuge - 1) & ~(kHuge - 1);
+        uintptr_t h_end = (static_cast<uintptr_t>(seg_page_start) + static_cast<uintptr_t>(file_length)) & ~(kHuge - 1);
+        if (h_end > h_start) {
+          (void)madvise(reinterpret_cast<void*>(h_start),
